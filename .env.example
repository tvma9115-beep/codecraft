# ============================================================
#  CodeCraft 环境变量模板
#  用法：复制本文件为 .env，再把假值换成真实值
#      cp .env.example .env      (PowerShell: Copy-Item)
#  .env 已被 .gitignore 忽略，不会被提交
# ============================================================

# ---------- 服务端口 ----------
PORT_API=3000
PORT_SANDBOX=0

# ---------- RDS for MySQL 8.0 ----------
# 注意：用内网地址，ECS 通过 VPC 内网连接
DB_HOST=192.168.0.100
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=codecraft
DB_CONNECTION_LIMIT=10

# ---------- DCS for Redis ----------
REDIS_HOST=192.168.0.101
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- LLM（只用于把结论讲成人话，不用于判定对错）----------
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=your-model-name
LLM_TIMEOUT_MS=15000
LLM_CACHE_TTL_SEC=86400

# ---------- 运行限制 ----------
RUN_TIMEOUT_MS=3000
RUN_MEMORY_MB=128
RUN_CPU_LIMIT=0.5
RATE_LIMIT_PER_MIN=10

# ---------- 前端 ----------
VITE_API_BASE=/api